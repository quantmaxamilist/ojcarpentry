---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import PhotoTile from '../components/PhotoTile.astro';
import { beforeAfter, categories } from '../data/gallery';
import { PHONE_DISPLAY, PHONE_HREF } from '../data/site';

const TEAL = '#00a9a2';
const OFFWHITE = '#f7f6f4';
const WHITE = '#ffffff';

const totalPhotos = categories.reduce((n, c) => n + c.photos.length, 0) + 2;

const title = 'Gallery | O.J. Carpentry — Kitchens, Bathrooms, Decking & Pergolas, Pembrokeshire';
const description =
  'Browse recent work by O.J. Carpentry in Narberth, Pembrokeshire — fitted kitchens, bathroom refits, composite decking, fencing and made-to-measure timber pergolas.';
---
<Layout title={title} description={description}>

<Nav />

<!-- PAGE HEADER -->
<section id="gallery-header" style={`background:${OFFWHITE};padding:72px 32px 40px;`}>
  <div style="max-width:1280px;margin:0 auto;text-align:center;">
    <p class="eyebrow" style="margin-bottom:16px;">Our Work</p>
    <h1 style="font-size:clamp(38px,5vw,62px);font-weight:700;letter-spacing:-0.03em;line-height:1.06;margin-bottom:18px;">
      Gallery
    </h1>
    <p class="lede" style="max-width:620px;margin:0 auto;">
      {totalPhotos} photos from recent projects across Pembrokeshire — fitted kitchens, bathroom
      refits, decking and fencing, and made-to-measure timber pergolas. Click any photo to view
      it full size.
    </p>
  </div>
</section>

<!-- CATEGORY TABS -->
<div id="tab-bar" style={`background:${OFFWHITE};position:sticky;top:76px;z-index:60;padding:0 32px 28px;`}>
  <div
    role="tablist"
    aria-label="Filter projects by category"
    style="max-width:1280px;margin:0 auto;display:flex;gap:10px;justify-content:center;flex-wrap:wrap;"
  >
    {categories.map((cat, i) => (
      <button
        type="button"
        role="tab"
        class:list={['tab', { active: i === 0 }]}
        id={`tab-${cat.id}`}
        data-target={cat.id}
        aria-controls={`panel-${cat.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
      >
        {cat.label}
        <span class="tab-count">{cat.id === 'kitchens' ? cat.photos.length + 2 : cat.photos.length}</span>
      </button>
    ))}
  </div>
</div>

<!-- PANELS -->
<section style={`background:${OFFWHITE};padding:8px 32px 96px;`}>
  <div style="max-width:1280px;margin:0 auto;">
    {categories.map((cat, i) => (
      <div
        role="tabpanel"
        id={`panel-${cat.id}`}
        class="panel"
        aria-labelledby={`tab-${cat.id}`}
        hidden={i !== 0}
      >
        <p class="panel-blurb">{cat.blurb}</p>

        {cat.id === 'kitchens' && (
          <div class="ba-block">
            <div class="ba-head">
              <h2 class="ba-title">Kitchen refurbishment</h2>
              <p class="ba-sub">A dated kitchen stripped out and replaced with a full shaker fit.</p>
            </div>
            <div class="ba-pair">
              <figure class="ba-item">
                <span class="ba-tag ba-tag-before">Before</span>
                <PhotoTile photo={beforeAfter.before} ratio="4/3" width={800} showCaption={false} />
              </figure>
              <figure class="ba-item">
                <span class="ba-tag ba-tag-after">After</span>
                <PhotoTile photo={beforeAfter.after} ratio="4/3" width={800} showCaption={false} />
              </figure>
            </div>
          </div>
        )}

        <div class="masonry">
          {cat.photos.map((photo) => (
            <div class="masonry-item">
              <PhotoTile photo={photo} width={780} />
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- CTA -->
<section style={`background:${WHITE};padding:88px 32px;border-top:1px solid rgba(35,35,35,0.07);text-align:center;`}>
  <div style="max-width:640px;margin:0 auto;">
    <p class="eyebrow" style="margin-bottom:16px;">Start Your Project</p>
    <h2 class="section-title" style="margin-bottom:16px;">Like what you see?</h2>
    <p class="lede" style="margin-bottom:32px;">
      Tell Owen what you have in mind and he'll come back to you with an honest, no-obligation
      quote.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <a href={PHONE_HREF} class="btn-teal">
        <i class="fa-solid fa-phone" aria-hidden="true"></i>Call {PHONE_DISPLAY}
      </a>
      <a href="/#contact" class="btn-outline">Request a Quote</a>
    </div>
  </div>
</section>

<Footer />
<Lightbox />

<style>
  .tab {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: #ffffff;
    border: 1px solid rgba(35, 35, 35, 0.12);
    border-radius: 999px;
    color: rgba(35, 35, 35, 0.72);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    padding: 12px 22px;
    cursor: pointer;
    transition: background 0.22s ease, color 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
  }
  .tab:hover {
    border-color: rgba(0, 169, 162, 0.5);
    color: #00807b;
    transform: translateY(-1px);
  }
  .tab.active {
    background: #00a9a2;
    border-color: #00a9a2;
    color: #ffffff;
  }
  .tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: rgba(35, 35, 35, 0.07);
    font-size: 11px;
    font-weight: 600;
  }
  .tab.active .tab-count { background: rgba(255, 255, 255, 0.24); }

  .panel[hidden] { display: none; }

  .panel-blurb {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 36px;
    font-size: 15px;
    line-height: 1.75;
    color: rgba(35, 35, 35, 0.6);
  }

  /* Before / after pair */
  .ba-block {
    background: #ffffff;
    border: 1px solid rgba(35, 35, 35, 0.08);
    border-radius: 14px;
    padding: 30px;
    margin-bottom: 32px;
  }
  .ba-head { text-align: center; margin-bottom: 24px; }
  .ba-title {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .ba-sub { font-size: 14px; color: rgba(35, 35, 35, 0.6); }
  .ba-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .ba-item { position: relative; margin: 0; }
  .ba-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 8px 14px;
    border-radius: 5px;
    pointer-events: none;
  }
  .ba-tag-before { background: #232323; color: #ffffff; }
  .ba-tag-after { background: #00a9a2; color: #ffffff; }

  /* Masonry */
  .masonry { columns: 3; column-gap: 16px; }
  .masonry-item { break-inside: avoid; margin-bottom: 16px; }

  @media (max-width: 1024px) {
    .masonry { columns: 2; }
  }

  @media (max-width: 900px) {
    #tab-bar { top: 68px !important; }
  }

  @media (max-width: 768px) {
    #gallery-header { padding-left: 20px !important; padding-right: 20px !important; }
    #tab-bar { padding-left: 12px !important; padding-right: 12px !important; }
    .tab { font-size: 13px; padding: 10px 16px; }
    .ba-block { padding: 18px; }
    .ba-pair { grid-template-columns: 1fr; gap: 14px; }
    .masonry { columns: 1; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));

  function activate(id: string, scroll = false) {
    const match = tabs.find((t) => t.dataset.target === id);
    if (!match) return;

    tabs.forEach((tab) => {
      const on = tab.dataset.target === id;
      tab.classList.toggle('active', on);
      tab.setAttribute('aria-selected', String(on));
    });

    panels.forEach((panel) => {
      panel.hidden = panel.id !== `panel-${id}`;
    });

    if (history.replaceState) history.replaceState(null, '', `#${id}`);
    if (scroll) {
      document.getElementById('tab-bar')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => activate(tab.dataset.target ?? '', true));
  });

  const fromHash = window.location.hash.replace('#', '');
  if (fromHash) activate(fromHash);
</script>

</Layout>
