---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import PhotoTile from '../components/PhotoTile.astro';
import { aboutPhoto, heroBackground, highlights } from '../data/gallery';
import { ADDRESS, EMAIL, PHONE_DISPLAY, PHONE_HREF, SOCIALS } from '../data/site';

const TEAL = '#00a9a2';
const TEAL_DARK = '#00807b';
const CHARCOAL = '#232323';
const OFFWHITE = '#f7f6f4';
const WHITE = '#ffffff';

const heroImage = await getImage({ src: heroBackground, width: 1920, format: 'webp', quality: 70 });
const aboutImage = aboutPhoto
  ? await getImage({ src: aboutPhoto.image, width: 760, format: 'webp', quality: 74 })
  : null;

const services = [
  { name: 'Kitchen Fitting', icon: 'fa-kitchen-set', desc: 'Full kitchen installations, from layout and units through to worktops and final fix.' },
  { name: 'Doors', icon: 'fa-door-open', desc: 'Internal and external doors hung square and true, including linings and ironmongery.' },
  { name: 'Flooring', icon: 'fa-table-cells', desc: 'Solid, engineered and laminate flooring laid to a clean, level finish.' },
  { name: 'Fencing', icon: 'fa-tree', desc: 'Garden and boundary fencing built to last against the Pembrokeshire weather.' },
  { name: 'New Builds', icon: 'fa-house-chimney', desc: 'First and second fix carpentry on new build projects for developers and self-builders.' },
  { name: 'Joinery', icon: 'fa-ruler-combined', desc: 'Made-to-measure joinery and bespoke timber work designed around your space.' },
  { name: 'Skirting', icon: 'fa-ruler-horizontal', desc: 'Skirting boards cut, scribed and fitted with tight, seamless joints throughout.' },
  { name: 'Architraves', icon: 'fa-vector-square', desc: 'Crisp architrave detailing around doors and openings to finish a room properly.' },
  { name: 'Decking', icon: 'fa-layer-group', desc: 'Timber and composite decking built level, solid and ready to enjoy.' },
  { name: 'Conversions', icon: 'fa-screwdriver-wrench', desc: 'Loft, garage and space conversions handled with full carpentry throughout.' },
];

const credentials = [
  { icon: 'fa-award', label: 'Qualified 2011', detail: 'Professionally trained carpenter' },
  { icon: 'fa-location-dot', label: 'Narberth Based', detail: 'Serving all of Pembrokeshire' },
  { icon: 'fa-comments', label: 'Free Quotes', detail: 'No obligation, honest pricing' },
];
---
<Layout>

<Nav />

<!-- HERO -->
<section id="hero">
  <img class="hero-bg" src={heroImage.src} alt="" aria-hidden="true" fetchpriority="high" />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-content">
    <p class="hero-eyebrow">Carpenter · Narberth · Pembrokeshire</p>

    <h1 class="hero-title">
      Carpentry done<br />
      <span>properly</span>, by hand.
    </h1>

    <p class="hero-lede">
      O.J. Carpentry is run by Owen James — a fully trained and qualified carpenter serving
      Narberth and the wider Pembrokeshire area. From kitchen fitting and joinery to decking,
      flooring and full conversions.
    </p>

    <div class="hero-ctas">
      <a href={PHONE_HREF} class="btn-teal">
        <i class="fa-solid fa-phone" aria-hidden="true"></i>Get a Free Quote
      </a>
      <a href="/gallery" class="btn-ghost">View Our Work</a>
    </div>

    <div class="hero-creds">
      {credentials.map((c) => (
        <div class="hero-cred">
          <i class={`fa-solid ${c.icon}`} aria-hidden="true"></i>
          <span class="hero-cred-label">{c.label}</span>
          <span class="hero-cred-detail">{c.detail}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ABOUT OWEN -->
<section id="about" class:list={['about', { 'about--no-photo': !aboutPhoto }]}>
  <div class="about-inner">
    {aboutPhoto && aboutImage && (
      <figure class="about-media reveal">
        <img
          src={aboutImage.src}
          alt={aboutPhoto.alt}
          width={aboutPhoto.image.width}
          height={aboutPhoto.image.height}
          loading="lazy"
          decoding="async"
        />
      </figure>
    )}

    <div class="about-copy reveal">
      <p class="about-eyebrow">
        <span class="eyebrow">About Owen</span>
        <span class="est-badge">Est. 2011</span>
      </p>
      <h2 class="section-title" style="margin-bottom:26px;">
        A qualified carpenter who takes pride in every job.
      </h2>
      <p class="lede" style="margin-bottom:20px;">
        O.J. Carpentry is run by Owen James, a fully trained and qualified carpenter. Owen first
        began woodworking at 18 and completed his professional training in 2011.
      </p>
      <p class="lede" style="margin-bottom:34px;">
        Since then he's built a strong reputation across the Pembrokeshire area. O.J. Carpentry
        takes great pride in the quality of its work and in the relationships built with every
        client along the way.
      </p>

      <div class="about-cards">
        {[
          ['fa-graduation-cap', 'Fully Qualified', 'Trained and certified in 2011'],
          ['fa-handshake', 'Client First', 'Built on trust and repeat work'],
          ['fa-screwdriver-wrench', 'All Aspects', 'Domestic and commercial carpentry'],
        ].map(([icon, title, sub]) => (
          <div class="about-card">
            <i class={`fa-solid ${icon}`} aria-hidden="true"></i>
            <p class="about-card-title">{title}</p>
            <p class="about-card-sub">{sub}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- WORK HIGHLIGHTS -->
<section id="work" style={`background:${OFFWHITE};padding:104px 32px;border-top:1px solid rgba(35,35,35,0.07);`}>
  <div style="max-width:1280px;margin:0 auto;">
    <div class="reveal" style="text-align:center;max-width:640px;margin:0 auto 48px;">
      <p class="eyebrow" style="margin-bottom:16px;">Recent Work</p>
      <h2 class="section-title" style="margin-bottom:16px;">Projects across Pembrokeshire</h2>
      <p class="lede">
        A handful of recent kitchens, bathrooms, pergolas and garden builds. Click any photo to
        see it full size.
      </p>
    </div>

    <div id="highlight-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
      {highlights.map((photo) => (
        <PhotoTile photo={photo} ratio="1/1" width={720} class="reveal" />
      ))}
    </div>

    <div class="reveal" style="text-align:center;margin-top:44px;">
      <a href="/gallery" class="btn-teal" style="padding:16px 36px;font-size:15px;">
        View Full Gallery
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section id="services" style={`background:${WHITE};padding:104px 32px;border-top:1px solid rgba(35,35,35,0.07);`}>
  <div style="max-width:1280px;margin:0 auto;">
    <div class="reveal" style="text-align:center;max-width:640px;margin:0 auto 52px;">
      <p class="eyebrow" style="margin-bottom:16px;">What We Do</p>
      <h2 class="section-title" style="margin-bottom:16px;">All aspects of carpentry</h2>
      <p class="lede">
        Ten core services covering everything from a single door to a full conversion — for
        homeowners, builders and commercial clients across Pembrokeshire.
      </p>
    </div>

    <div id="services-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
      {services.map((s) => (
        <div
          class="reveal service-card"
          style={`background:${OFFWHITE};border:1px solid rgba(35,35,35,0.07);border-radius:12px;padding:30px 26px;transition:border-color 0.25s ease,transform 0.25s ease,box-shadow 0.25s ease;`}
        >
          <span style={`display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:12px;background:rgba(0,169,162,0.12);color:${TEAL};margin-bottom:20px;`}>
            <i class={`fa-solid ${s.icon}`} style="font-size:20px;" aria-hidden="true"></i>
          </span>
          <h3 style="font-size:20px;font-weight:600;letter-spacing:-0.01em;margin-bottom:9px;">{s.name}</h3>
          <p style="font-size:14px;line-height:1.72;color:rgba(35,35,35,0.6);">{s.desc}</p>
        </div>
      ))}

      <div
        class="reveal"
        style={`background:${TEAL};border-radius:12px;padding:30px 26px;display:flex;flex-direction:column;justify-content:space-between;color:${WHITE};`}
      >
        <div>
          <span style="display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:12px;background:rgba(255,255,255,0.18);margin-bottom:20px;">
            <i class="fa-solid fa-comment-dots" style="font-size:20px;" aria-hidden="true"></i>
          </span>
          <h3 style="font-size:20px;font-weight:600;margin-bottom:9px;">Something else?</h3>
          <p style="font-size:14px;line-height:1.72;color:rgba(255,255,255,0.85);">
            If it involves timber, ask. Owen will talk you through the options and quote it honestly.
          </p>
        </div>
        <a
          href={PHONE_HREF}
          style={`margin-top:26px;display:inline-flex;align-items:center;gap:9px;background:${WHITE};color:${TEAL_DARK};font-size:13px;font-weight:600;padding:13px 20px;border-radius:6px;text-decoration:none;width:fit-content;`}
        >
          <i class="fa-solid fa-phone" aria-hidden="true"></i>Call {PHONE_DISPLAY}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- REVIEWS -->
<section id="reviews" style={`background:${OFFWHITE};padding:104px 32px;border-top:1px solid rgba(35,35,35,0.07);`}>
  <div style="max-width:1280px;margin:0 auto;">
    <div class="reveal" style="text-align:center;max-width:620px;margin:0 auto 40px;">
      <p class="eyebrow" style="margin-bottom:16px;">Client Feedback</p>
      <h2 class="section-title" style="margin-bottom:16px;">Reviews</h2>
      <p class="lede">
        Owen has built a strong reputation across Pembrokeshire on the strength of his work and
        repeat business. Verified client reviews are being collected and will appear here shortly.
      </p>
    </div>

    <div id="reviews-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
      {[0, 1, 2].map(() => (
        <div class="reveal placeholder-tile" style="min-height:220px;align-items:flex-start;text-align:left;">
          <i class="fa-solid fa-quote-left" style={`color:${TEAL};font-size:20px;`} aria-hidden="true"></i>
          <span class="ph-label">Review slot</span>
          <span class="ph-note" style="max-width:100%;">Awaiting verified client review — content incoming.</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FIND US -->
<section id="find-us" style={`background:${WHITE};padding:104px 32px;border-top:1px solid rgba(35,35,35,0.07);`}>
  <div style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start;">
    <div class="reveal">
      <p class="eyebrow" style="margin-bottom:16px;">Find Us</p>
      <h2 class="section-title" style="margin-bottom:16px;">Based in Narberth</h2>
      <p class="lede" style="margin-bottom:36px;">
        O.J. Carpentry works with domestic and commercial clients throughout Narberth and the
        wider Pembrokeshire area.
      </p>

      <div style="display:flex;flex-direction:column;gap:22px;margin-bottom:32px;">
        <div style="display:flex;gap:16px;align-items:flex-start;">
          <span style={`display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:10px;background:rgba(0,169,162,0.12);color:${TEAL};flex-shrink:0;`}>
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
          </span>
          <p style="font-size:15px;line-height:1.75;color:rgba(35,35,35,0.75);">
            <strong style={`display:block;color:${CHARCOAL};font-family:'Outfit',sans-serif;`}>O.J. Carpentry</strong>
            {ADDRESS.street}<br />
            {ADDRESS.locality}, {ADDRESS.region}<br />
            {ADDRESS.postcode}
          </p>
        </div>

        <div style="display:flex;gap:16px;align-items:center;">
          <span style={`display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:10px;background:rgba(0,169,162,0.12);color:${TEAL};flex-shrink:0;`}>
            <i class="fa-solid fa-phone" aria-hidden="true"></i>
          </span>
          <a href={PHONE_HREF} style={`font-family:'Outfit',sans-serif;font-size:22px;font-weight:700;color:${TEAL};text-decoration:none;`}>{PHONE_DISPLAY}</a>
        </div>

        <div style="display:flex;gap:16px;align-items:center;">
          <span style={`display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:10px;background:rgba(0,169,162,0.12);color:${TEAL};flex-shrink:0;`}>
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          </span>
          <a href={`mailto:${EMAIL}`} style="font-size:15px;color:rgba(35,35,35,0.75);text-decoration:none;">{EMAIL}</a>
        </div>
      </div>

      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        {SOCIALS.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            data-magnetic
            aria-label={`O.J. Carpentry on ${s.name}`}
            class="social-pill"
          >
            <i class={`fa-brands ${s.icon}`} aria-hidden="true"></i>
            {s.name}
          </a>
        ))}
      </div>
    </div>

    <div class="reveal" style="overflow:hidden;border-radius:12px;border:1px solid rgba(35,35,35,0.1);">
      <iframe
        title="O.J. Carpentry — Narberth, Pembrokeshire on Google Maps"
        src="https://maps.google.com/maps?q=25+Redstone+Court,+Narberth,+Pembrokeshire,+SA67+7EU&output=embed"
        width="100%"
        height="460"
        style="border:0;display:block;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact" style={`background:${OFFWHITE};padding:104px 32px;border-top:1px solid rgba(35,35,35,0.07);`}>
  <div style="max-width:720px;margin:0 auto;">
    <div class="reveal" style="text-align:center;margin-bottom:40px;">
      <p class="eyebrow" style="margin-bottom:16px;">Get In Touch</p>
      <h2 class="section-title" style="margin-bottom:16px;">Request a free quote</h2>
      <p class="lede">
        Send over a few details about your project and Owen will get back to you with an honest,
        no-obligation quote.
      </p>
    </div>

    <form
      class="reveal"
      action="https://api.web3forms.com/submit"
      method="POST"
      style={`background:${WHITE};border:1px solid rgba(35,35,35,0.08);border-radius:14px;padding:34px;display:flex;flex-direction:column;gap:14px;`}
    >
      <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_KEY" />
      <input type="hidden" name="subject" value="New Quote Request - O.J. Carpentry" />

      <div id="contact-row" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <input class="field" type="text" name="name" placeholder="Your name" required />
        <input class="field" type="tel" name="phone" placeholder="Phone number" />
      </div>
      <input class="field" type="email" name="email" placeholder="Email address" required />
      <input class="field" type="text" name="service" placeholder="Service required (kitchen fitting, decking, joinery…)" />
      <textarea class="field" name="message" rows="5" placeholder="Tell us about your project…"></textarea>

      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:6px;">
        <button type="submit" class="btn-teal" style="flex:1;min-width:200px;">Send Message</button>
        <a href={PHONE_HREF} class="btn-outline">Call {PHONE_DISPLAY}</a>
      </div>
    </form>
  </div>
</section>

<Footer />
<Lightbox />

<style>
  /* HERO — full-bleed photo, dimmed, with all copy layered on top in one section.
     Entrance animation is pure CSS so the text can never be left stranded at
     opacity:0 if a script fails to run. */
  #hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(560px, 76vh, 720px);
    padding: 96px 32px;
    overflow: hidden;
    background: #232323;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        100deg,
        rgba(35, 35, 35, 0.93) 0%,
        rgba(35, 35, 35, 0.84) 42%,
        rgba(35, 35, 35, 0.6) 100%
      );
  }
  .hero-content {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #4fd6d0;
    margin-bottom: 20px;
  }
  .hero-title {
    font-size: clamp(40px, 5.4vw, 70px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 22px;
  }
  .hero-title span { color: #00a9a2; }
  .hero-lede {
    max-width: 560px;
    font-size: 16px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 32px;
  }
  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    padding: 15px 30px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    text-decoration: none;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  .hero-creds {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 620px;
  }
  .hero-cred { display: flex; flex-direction: column; gap: 6px; }
  .hero-cred i { color: #00a9a2; font-size: 17px; }
  .hero-cred-label {
    font-family: 'Outfit', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
  }
  .hero-cred-detail {
    font-size: 12px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.74);
  }

  @keyframes heroRise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  .hero-content > * {
    animation: heroRise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-content > *:nth-child(2) { animation-delay: 0.07s; }
  .hero-content > *:nth-child(3) { animation-delay: 0.14s; }
  .hero-content > *:nth-child(4) { animation-delay: 0.21s; }
  .hero-content > *:nth-child(5) { animation-delay: 0.28s; }

  /* About — two columns when a portrait exists, centred single column when it doesn't. */
  .about {
    background: #ffffff;
    padding: 104px 32px;
    border-top: 1px solid rgba(35, 35, 35, 0.07);
  }
  .about-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 72px;
    align-items: center;
  }
  .about--no-photo .about-inner {
    grid-template-columns: 1fr;
    max-width: 840px;
    text-align: center;
  }

  .about-media { position: relative; margin: 0; max-width: 420px; }
  .about-media img {
    width: 100%;
    /* height:auto is required — the intrinsic height attribute would otherwise win
       over aspect-ratio and render the photo at full source height. */
    height: auto;
    aspect-ratio: 1/1;
    object-fit: cover;
    /* Framed on the van's signwriting rather than the tarmac below it. */
    object-position: 50% 36%;
    display: block;
    border-radius: 12px;
  }

  .about-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .about--no-photo .about-eyebrow { justify-content: center; }

  .est-badge {
    display: inline-flex;
    align-items: center;
    background: #00a9a2;
    color: #ffffff;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 6px;
  }

  .about-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    text-align: left;
  }
  .about-card {
    background: #f7f6f4;
    border: 1px solid rgba(35, 35, 35, 0.07);
    border-radius: 10px;
    padding: 20px 18px;
  }
  .about-card i {
    color: #00a9a2;
    font-size: 18px;
    margin-bottom: 12px;
    display: block;
  }
  .about-card-title {
    font-family: 'Outfit', sans-serif;
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 5px;
  }
  .about-card-sub {
    font-size: 12px;
    line-height: 1.6;
    color: rgba(35, 35, 35, 0.55);
  }

  .service-card:hover {
    border-color: rgba(0,169,162,0.45) !important;
    transform: translateY(-3px);
    box-shadow: 0 16px 34px rgba(35,35,35,0.07);
  }

  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    background: #f7f6f4;
    border: 1px solid rgba(35,35,35,0.1);
    border-radius: 8px;
    padding: 13px 20px;
    color: #232323;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }
  .social-pill i { color: #00a9a2; font-size: 19px; }
  .social-pill:hover {
    border-color: rgba(0,169,162,0.5);
    background: rgba(0,169,162,0.06);
    transform: translateY(-2px);
  }

  .field {
    width: 100%;
    background: #f7f6f4;
    border: 1px solid rgba(35,35,35,0.12);
    border-radius: 8px;
    color: #232323;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    padding: 15px 17px;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .field::placeholder { color: rgba(35,35,35,0.42); }
  .field:focus { border-color: #00a9a2; background: #ffffff; }
  textarea.field { resize: vertical; }

  @media (max-width: 1024px) {
    .about-inner { grid-template-columns: 1fr; gap: 44px; justify-items: center; text-align: center; }
    .about-cards { text-align: left; }
    .about-eyebrow { justify-content: center; }
    #find-us > div { grid-template-columns: 1fr !important; gap: 36px !important; }
    #services-grid { grid-template-columns: repeat(2, 1fr) !important; }
    #reviews-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }

  @media (max-width: 768px) {
    section { padding-left: 20px !important; padding-right: 20px !important; }
    #hero { min-height: auto; padding-top: 72px; padding-bottom: 72px; }
    .hero-creds { grid-template-columns: 1fr; gap: 18px; }
    .hero-scrim {
      background: linear-gradient(180deg, rgba(35,35,35,0.86) 0%, rgba(35,35,35,0.92) 100%);
    }
    #services-grid { grid-template-columns: 1fr !important; }
    #reviews-grid { grid-template-columns: 1fr !important; }
    #highlight-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 12px !important; }
    #contact-row { grid-template-columns: 1fr !important; }
    .about-media { max-width: 300px; }
    .about-cards { grid-template-columns: 1fr; }
  }

  @media (max-width: 460px) {
    #highlight-grid { grid-template-columns: 1fr !important; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from '@studio-freight/lenis';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    gsap.registerPlugin(ScrollTrigger);

    const lenis = new Lenis({ lerp: 0.09, smoothWheel: true });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);

    // The hero animates via CSS instead — nothing above the fold should depend on
    // this bundle loading and its ticker running.
    gsap.utils.toArray<HTMLElement>('.reveal').forEach((el) => {
      gsap.fromTo(
        el,
        { y: 32, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none none' },
        },
      );
    });
  }
</script>

</Layout>
