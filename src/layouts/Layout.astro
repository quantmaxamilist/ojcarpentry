---
interface Props { title?: string; description?: string; }
const {
  title = "O.J. Carpentry | Carpenter Narberth | Kitchen Fitting & Joinery Pembrokeshire",
  description = "O.J. Carpentry — carpenter in Narberth, Pembrokeshire. Kitchen fitting, doors, flooring, decking, fencing, joinery and new builds. Run by Owen James, qualified since 2011. Call 07825 326494.",
} = Astro.props;

const services = [
  'Kitchen Fitting',
  'Doors',
  'Flooring',
  'Fencing',
  'New Builds',
  'Joinery',
  'Skirting',
  'Architraves',
  'Decking',
  'Conversions',
];

const schemaLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://ojcarpentry.co.uk/#business",
  name: "O.J. Carpentry",
  alternateName: "Owen James Carpentry",
  description:
    "O.J. Carpentry is a carpenter based in Narberth, Pembrokeshire, run by Owen James. Services include kitchen fitting, doors, flooring, fencing, new builds, joinery, skirting, architraves, decking and conversions.",
  telephone: "+447825326494",
  email: "owen@ojcarpentry.co.uk",
  url: "https://ojcarpentry.co.uk",
  address: {
    "@type": "PostalAddress",
    streetAddress: "25 Redstone Court",
    addressLocality: "Narberth",
    addressRegion: "Pembrokeshire",
    postalCode: "SA67 7EU",
    addressCountry: "GB",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 51.7982,
    longitude: -4.7439,
  },
  areaServed: [
    { "@type": "Place", name: "Narberth" },
    { "@type": "Place", name: "Pembrokeshire" },
  ],
  knowsAbout: services,
  makesOffer: services.map((name) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name },
  })),
  priceRange: "££",
  sameAs: ["https://www.facebook.com/O-J-Carpentry-1103888859639191/"],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#00a9a2" />
  <link rel="canonical" href="https://ojcarpentry.co.uk/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://ojcarpentry.co.uk/" />
  <meta property="og:locale" content="en_GB" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <script type="application/ld+json" set:html={JSON.stringify(schemaLd)} />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: #f7f6f4;
      color: #232323;
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, h4 { font-family: 'Outfit', sans-serif; }
    ::selection { background: rgba(0,169,162,0.22); color: #232323; }
    a { color: inherit; }
    :focus-visible { outline: 2px solid #00a9a2; outline-offset: 3px; }

    ::-webkit-scrollbar { width: 10px; }
    ::-webkit-scrollbar-track { background: #ecebe8; }
    ::-webkit-scrollbar-thumb { background: #c9c8c4; border-radius: 999px; }
    ::-webkit-scrollbar-thumb:hover { background: #00a9a2; }

    .eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #00a9a2;
    }
    .section-title {
      font-size: clamp(34px, 4.4vw, 54px);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.08;
      color: #232323;
    }
    .lede {
      font-size: 16px;
      line-height: 1.8;
      color: rgba(35,35,35,0.66);
    }
    .btn-teal {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: #00a9a2;
      color: #ffffff;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.02em;
      padding: 15px 30px;
      border-radius: 6px;
      border: none;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.25s ease, transform 0.25s ease;
    }
    .btn-teal:hover { background: #00807b; transform: translateY(-2px); }
    .btn-outline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: transparent;
      color: #232323;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 600;
      padding: 15px 30px;
      border-radius: 6px;
      border: 1px solid rgba(35,35,35,0.18);
      text-decoration: none;
      transition: border-color 0.25s ease, background 0.25s ease;
    }
    .btn-outline:hover { border-color: #00a9a2; background: rgba(0,169,162,0.06); }

    .placeholder-tile {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-align: center;
      background:
        repeating-linear-gradient(
          45deg,
          #eeedea 0px,
          #eeedea 12px,
          #f4f3f1 12px,
          #f4f3f1 24px
        );
      border: 1px dashed rgba(0,169,162,0.45);
      border-radius: 10px;
      color: rgba(35,35,35,0.5);
      padding: 24px;
    }
    .placeholder-tile .ph-label {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #00807b;
    }
    .placeholder-tile .ph-note {
      font-size: 12px;
      line-height: 1.6;
      max-width: 240px;
      color: rgba(35,35,35,0.5);
    }

    .lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 200;
      background: rgba(35,35,35,0.92);
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .lightbox.open { display: flex; }
    .lightbox img {
      max-width: min(1100px, 100%);
      max-height: 90vh;
      object-fit: contain;
      border-radius: 8px;
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>
